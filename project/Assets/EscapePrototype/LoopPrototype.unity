  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.EchoScene
  EchoId: talk_mizuno
  NoteTitle: "\u6B8B\u97FF\uFF1A\u4F1A\u8A71\uFF08\u6C34\u91CE\u306E\u8A18\u61B6\uFF09"
  NoteBody: "\u90E8\u5C4B\u306E\u4E2D\u3067\u3001\u5C0F\u67C4\u306A\u5F71\u304C\u51FA\u53E3\u3092\u80CC\u306B\u3057\u3066\u7ACB\u3061\u3059\u304F\u3093\u3067\u3044\u308B\u3002\n\u5411\u304B\u3044\u306B\u306F\u2500\u2500\u9854\u306E\u306A\u3044\u3001\u771F\u3063\u9ED2\u306A\u5F71\u3002\n\u95C7\u3088\u308A\u6FC3\u3044\u8F2A\u90ED\u3060\u3051\u304C\u305D\u3053\u306B\u3042\u308A\u3001\n\u9854\u304C\u3042\u308B\u3079\u304D\u5834\u6240\u306B\u306F\u3001\u4F55\u3082\u306A\u3044\u3002\n\n\u75C5\u68DF\u3067\u898B\u305F\u306E\u3068\u3001\u540C\u3058\u5834\u9762\u306E\u306F\u305A\u3060\u3002\n\u306A\u306E\u306B\u3001\u3069\u3046\u3057\u3066\u3002\u5F7C\u5973\u306F\u3053\u3093\u306A\u306B\u3001\u602F\u3048\u3066\u3044\u308B\u3002"
  ActivateRadius: 6
  DissolveRadius: 1.3
  ReappearSeconds: 8
  SwayAmount: 2.6
  SwaySpeed: 1.2
  VoicePitch: 0.6
  VoiceVolume: 0.8
  Figures:
  - {fileID: 2141635475}
  - {fileID: 919906306}
  FigureSway:
  - 1
