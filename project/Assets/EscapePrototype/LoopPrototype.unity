  m_Script: {fileID: 11500000, guid: cd8d1d6e5a115064583ec21f65b18866, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopSequenceLock
  RoomId: core_ante
  Id: power
  DisplayName: "\u914D\u96FB\u76E4"
  HintDocId: core_ante_manual
  SuccessNoteTitle: "\u914D\u96FB\u76E4\uFF1A\u7CFB\u7D71\u5FA9\u96FB \u5B8C\u4E86"
  SuccessNoteBody: "\u8A18\u61B6\u91CE\u3001\u8A00\u8A9E\u91CE\u3001\u81EA\u5DF1\u8A8D\u8B58\u91CE\u2500\u2500\u624B\u9806\u66F8\u3069\u304A\u308A\u306E\u9806\u3067\u7D66\u96FB\u3057\u305F\u3002\n\u86CD\u5149\u706F\u304C\u4E00\u672C\u305A\u3064\u70B9\u3044\u3066\u3044\u304F\u3002\n\n\u2026\u2026\u4ED5\u69D8\u3092\u5B88\u3063\u305F\u3002\u5B88\u3063\u305F\u306E\u306B\u3002\n\u4F55\u304B\u304C\u3001\u76EE\u3092\u899A\u307E\u3057\u305F\u6C17\u304C\u3059\u308B\u3002"
  RequireFound: 
  RequireMessage: "\u307E\u3060\u3001\u5FC5\u8981\u306A\u3082\u306E\u304C\u63C3\u3063\u3066\u3044\u306A\u3044\u3002"
  Title: "\u914D\u96FB\u76E4\u3000\u2500\u2500 \u7CFB\u7D71\u5225\u7D66\u96FB \u2500\u2500"
