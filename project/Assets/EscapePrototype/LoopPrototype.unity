  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: saeki_home
  Id: envelope
  DisplayName: "\u5C01\u7B52"
  NoteTitle: "\u59BB\u306B\u5B9B\u3066\u305F\u5C01\u7B52"
  NoteBody: "\u300A\u5C01\u7B52\u306E\u4E2D\u306E\u624B\u7D19\u300B\n\n\u300C\u541B\u306B\u8B1D\u3089\u306A\u3051\u308C\u3070\u306A\u3089\u306A\u3044\u3002\n\u591C\u4E2D\u306B\u66F8\u658E\u3067\u8B1D\u3063\u3066\u3044\u305F\u306E\u306F\u3001\u541B\u306B\u3058\u3083\u306A\u3044\u3002\n\u307E\u3060\u4F1A\u3063\u305F\u3053\u3068\u3082\u306A\u3044\u3001\u8AB0\u304B\u306B\u3060\u3002\n\n\u88DC\u5B8C\u30A2\u30EB\u30B4\u30EA\u30BA\u30E0\u306F\u3001\u6B20\u3051\u305F\u8A18\u61B6\u3092\u300E\u305D\u306E\u4EBA\u3089\u3057\u3044\u8A18\u61B6\u300F\u3067\u57CB\u3081\u308B\u3002\n\u3060\u304C\u305D\u306E\u8A18\u61B6\u306F\u3001\u3069\u3053\u304B\u304B\u3089\u6301\u3063\u3066\u3053\u306A\u3051\u308C\u3070\u306A\u3089\u306A\u3044\u3002\n\u4EBA\u306E\u8133\u3092\u6B32\u3057\u304C\u308B\u4ED5\u7D44\u307F\u3092\u4F5C\u3063\u305F\u306E\u306F\u3001\u50D5\u3060\u3002\n\u3042\u306E\u4EBA\u3092\u8FFD\u3044\u8A70\u3081\u305F\u306E\u3082\u3001\u305F\u3076\u3093\u50D5\u306E\u4F5C\u3063\u305F\u4ED5\u7D44\u307F\u3060\u3002\n\n\u3060\u304B\u3089\u3001\u50D5\u304C\u6B62\u3081\u306B\u884C\u304F\u3002\n\u3082\u3057\u623B\u3089\u306A\u304B\u3063\u305F\u3089\u3001\u3042\u306E\u4EBA\u3092\u6068\u307E\u306A\u3044\u3067\u307B\u3057\u3044\u3002\n\u3042\u306E\u4EBA\u306F\u3001\u5A18\u3055\u3093\u3092\u52A9\u3051\u305F\u3044\u3060\u3051\u306A\u3093\u3060\u300D\n\n\uFF08\u5C01\u306F\u5207\u3089\u308C\u3066\u3044\u306A\u3044\uFF09"
