  m_Script: {fileID: 11500000, guid: 0215d13445bdaa040ae19885078bf2e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: analysis
  Id: plan
  DisplayName: "\u7814\u7A76\u8A08\u753B\u66F8"
  NoteTitle: "\u30EA\u30CA\u30B7\u30FC\u30BF\u7814\u7A76\u8A08\u753B\u66F8"
  NoteBody: "\u300ARENASCITA \u7814\u7A76\u8A08\u753B\u66F8 \u8868\u7D19\u300B\n\n\u5BFE\u8C61:
    \u9077\u5EF6\u6027\u610F\u8B58\u969C\u5BB3\uFF08\u3044\u308F\u3086\u308B\u690D\u7269\u72B6\u614B\uFF09\n\u65B9\u91DD:
    \u640D\u50B7\u3057\u305F\u8133\u306E\u8A18\u61B6\u30FB\u4EBA\u683C\u91CE\u3092\n\u3000\u3000\u3000\u5916\u90E8\u3088\u308A\u88DC\u5B8C\u3057\u3001\u610F\u8B58\u306E\u518D\u69CB\u6210\u3092\u4FC3\u3059\n\n\u300A\u30B9\u30AD\u30E3\u30F3\u624B\u9806
    \u629C\u7C8B\u300B\n\u30FB\u8133\u60C5\u5831\u306F\u30D8\u30EB\u30E1\u30C3\u30C8\u578B\u30B9\u30AD\u30E3\u30F3\u88C5\u7F6E\u3067\u53D6\u5F97\u3059\u308B\n\u30FB\u899A\u9192\u4E0B\u30FB\u7761\u7720\u4E0B\u3068\u3082\u306B\u5F37\u3044\u4E0D\u5FEB\u611F\u3092\u4F34\u3044\u3001\n\u3000\u88AB\u9A13\u8005\u304C\u8010\u3048\u3089\u308C\u305A10%\u3082\u53D6\u5F97\u3067\u304D\u306A\u3044\n\u30FB\u6A5F\u80FD\u4F4E\u4E0B\u85AC\u306E\u6295\u4E0E\u4E0B\u306710%\u306E\u53D6\u5F97\u306B\u6210\u529F\u3002\n\u3000\u305F\u3060\u3057\u5FA9\u5E30\u6642\u306B\u5065\u5FD8\u30FB\u610F\u8B58\u6DF7\u6FC1\u306E\u30EA\u30B9\u30AF\u304C\u3042\u308B\u3002\n\u3000\u53D6\u5F97\u30C7\u30FC\u30BF\u306E\u78BA\u5B9F\u6027\u306F\u9AD8\u3044\n\n\u2500\u2500\u30EA\u30CA\u30B7\u30FC\u30BF\u3002\u30A4\u30BF\u30EA\u30A2\u8A9E\u3067\u300C\u518D\u8A95\u300D\u3002\n\u3053\u306E\u97FF\u304D\u3092\u3001\u79C1\u306F\u77E5\u3063\u3066\u3044\u308B\u3002\n\u7948\u308B\u3088\u3046\u306B\u53E3\u306B\u3057\u305F\u3053\u3068\u304C\u3001\u3042\u308B\u3002"
  Highlight: {fileID: 1206674119}
  DisappearOnPickup: 0
  PickupHint: 
