  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: system_room
  Id: restored
  DisplayName: "\u5FA9\u5143\u30D5\u30A1\u30A4\u30EB"
  NoteTitle: "\u5FA9\u5143\u3055\u308C\u305F\u64CD\u4F5C\u8A18\u9332"
  NoteBody: "\u300ABRAIN DATA \u767B\u9332\u64CD\u4F5C \u5FA9\u5143\u30ED\u30B0\u300B\n\n\u3000DATA:01
    \u767B\u9332\u5B9F\u884C\u8005\u2500\u2500NINOMIYA HIDEKI\n\u3000DATA:02 \u767B\u9332\u5B9F\u884C\u8005\u2500\u2500NINOMIYA
    HIDEKI\n\u3000DATA:03 \u767B\u9332\u5B9F\u884C\u8005\u2500\u2500NINOMIYA HIDEKI\n\n\u2026\u2026\u2026\u2026\u2026\u2026\u3002\n\n\u9055\u3046\u3002\u4F55\u304B\u306E\u9593\u9055\u3044\u3060\u3002\u3060\u3063\u3066\u79C1\u306F\u3001\u79C1\u306F\u2500\u2500\n\n\u2500\u2500\u601D\u3044\u51FA\u3057\u305F\u3002\n\u89E3\u6790\u5BA4\u306E\u591C\u3002\u300C\u4F55\u3092\u3059\u308B\u3064\u3082\u308A\u3067\u3059\u304B\u300D\u306E\u58F0\u3002\n\u75C5\u68DF\u306E\u5ECA\u4E0B\u3002\u30A2\u30D1\u30FC\u30C8\u306E\u30C9\u30A2\u3002\n\u9ED2\u3044\u5F71\u306B\u306F\u3001\u9854\u304C\u7121\u304B\u3063\u305F\u3093\u3058\u3083\u306A\u3044\u3002\n\u3042\u308C\u306F\u3001\u300C\u79C1\u304B\u3089\u898B\u305F\u79C1\u300D\u3060\u3063\u305F\u3093\u3060\u3002\n\n\u79C1\u304C\u30013\u4EBA\u306B\u6A5F\u80FD\u505C\u6B62\u85AC\u3092\u6253\u3063\u305F\u3002\n\u30D8\u30EB\u30E1\u30C3\u30C8\u3092\u88AB\u305B\u3001100%\u306E\u30B9\u30AD\u30E3\u30F3\u3092\u56DE\u3057\u305F\u3002\n\u56DE\u5FA9\u85AC\u306F\u3001\u3082\u3046\u52B9\u304B\u306A\u3044\u3002\n3\u4EBA\u306F\u6B7B\u3093\u3067\u3044\u306A\u3044\u3002\u2500\u2500\u5A18\u3068\u540C\u3058\u5834\u6240\u3067\u3001\n\u5A18\u3068\u540C\u3058\u3088\u3046\u306B\u3001\u4E8C\u5EA6\u3068\u76EE\u899A\u3081\u305A\u306B\u7720\u3063\u3066\u3044\u308B\u3002\n\u5A18\u3092\u52A9\u3051\u308B\u305F\u3081\u306E\u300C\u63D0\u4F9B\u4F53\u300D\u306B\u3001\u3059\u308B\u305F\u3081\u306B\u3002"
