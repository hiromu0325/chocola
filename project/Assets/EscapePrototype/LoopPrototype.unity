  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: dim
  Id: news
  DisplayName: "\u65B0\u805E\u8A18\u4E8B"
  NoteTitle: "\u65B0\u805E\u8A18\u4E8B\uFF08\u5207\u308A\u629C\u304D\uFF09"
  NoteBody: "20XX\u5E7411\u670825\u65E5\u3000\u671D\u520A\n\n\u4E09\u6728\u8133\u795E\u7D4C\u7DCF\u5408\u7814\u7A76\u6240\uFF08\u6240\u5728\u5730\u30FBXX\u770C\uFF09\u306F22\u65E5\u3001\u8133\u795E\u7D4C\u6D3B\u52D5\u306B\u95A2\u3059\u308B\u65B0\u305F\u306A\u6CBB\u7642\u6CD5\u306E\u78BA\u7ACB\u3092\u76EE\u6307\u3059\u81E8\u5E8A\u5B9F\u9A13\u3092\u518D\u958B\u3057\u305F\u3068\u767A\u8868\u3057\u305F\u3002\u4E00\u65B9\u3001\u95A2\u4FC2\u8005\u306B\u3088\u308B\u3068\u3001\u5B9F\u9A13\u306B\u53C2\u52A0\u3057\u305F\u88AB\u9A13\u80053\u540D\u304C\u610F\u8B58\u3092\u56DE\u5FA9\u3057\u306A\u3044\u72B6\u614B\u306B\u9665\u3063\u3066\u3044\u308B\u3053\u3068\u304C\u660E\u3089\u304B\u306B\u306A\u3063\u305F\u3002\n\n\u540C\u7814\u7A76\u6240\u306F\u3001\u8133\u306E\u795E\u7D4C\u6D3B\u52D5\u3092\u89E3\u6790\u30FB\u5236\u5FA1\u3059\u308B\u3053\u3068\u3067\u3001\u610F\u8B58\u969C\u5BB3\u306E\u6CBB\u7642\u3084\u8133\u6A5F\u80FD\u306E\u56DE\u5FA9\u3092\u76EE\u6307\u3059\u7814\u7A76\u3092\u9032\u3081\u3066\u304D\u305F\u3002\u4ECA\u56DE\u306E\u81E8\u5E8A\u5B9F\u9A13\u306F\u3001\u904E\u53BB\u306B\u5B9F\u65BD\u3055\u308C\u305F\u7814\u7A76\u8A08\u753B\u3092\u767A\u5C55\u3055\u305B\u305F\u3082\u306E\u3067\u3001\u9577\u671F\u306B\u308F\u305F\u308A\u610F\u8B58\u306E\u56DE\u5FA9\u304C\u898B\u3089\u308C\u306A\u3044\u60A3\u8005\u3078\u306E\u5FDC\u7528\u3082\u8996\u91CE\u306B\u5165\u308C\u3066\u3044\u308B\u3068\u3044\u3046\u3002\n\n\u3057\u304B\u3057\u3001\u8907\u6570\u306E\u95A2\u4FC2\u8005\u306E\u8A3C\u8A00\u306B\u3088\u308C\u3070\u3001\u5B9F\u9A13\u7D42\u4E86\u5F8C\u3082\u76EE\u3092\u899A\u307E\u3055\u306A\u3044\u88AB\u9A13\u8005\u304C\u78BA\u8A8D\u3055\u308C\u3066\u304A\u308A\u3001\u533B\u7642\u95A2\u4FC2\u8005\u306E\u9593\u3067\u306F\u5B89\u5168\u6027\u3092\u61F8\u5FF5\u3059\u308B\u58F0\u304C\u4E0A\u304C\u3063\u3066\u3044\u308B\u3002\u88AB\u9A13\u8005\u3089\u306F\u751F\u547D\u7DAD\u6301\u306B\u5FC5\u8981\u306A\u8EAB\u4F53\u6A5F\u80FD\u3092\u4FDD\u3063\u3066\u3044\u308B\u3082\u306E\u306E\u3001\u5916\u90E8\u304B\u3089\u306E\u547C\u3073\u304B\u3051\u306B\u5BFE\u3059\u308B\u53CD\u5FDC\u306F\u7121\u304F\u3001\u610F\u8B58\u72B6\u614B\u306E\u8A73\u7D30\u306B\u3064\u3044\u3066\u306F\u5206\u304B\u3063\u3066\u3044\u306A\u3044\u3002\n\n\u540C\u7814\u7A76\u6240\u306E\u4E09\u6728\u5B97\u82F1\u4E3B\u4EFB\u306F\u53D6\u6750\u306B\u5BFE\u3057\u3001\u300C\u73FE\u5728\u3001\u539F\u56E0\u306E\u7279\u5B9A\u3068\u88AB\u9A13\u8005\u306E\u72B6\u614B..."
