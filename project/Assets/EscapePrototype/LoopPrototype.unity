--- !u!114 &2124185023
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2124185021}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0215d13445bdaa040ae19885078bf2e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: analysis
  Id: plan
  DisplayName: "\u7814\u7A76\u8A08\u753B\u66F8"
  NoteTitle: "\u30EA\u30CA\u30B7\u30FC\u30BF\u7814\u7A76\u8A08\u753B\u66F8"
  NoteBody: "\u7814\u7A76\u8A08\u753B\u66F8 project:RENASCITA\n\n\u6587\u66F8\u756A\u53F7\uFF1AMNR-RP-0001\n\u7814\u7A76\u8AB2\u984C\uFF1A\u4EBA\u5DE5\u77E5\u80FD\u306B\u3088\u308B\u8A18\u61B6\u69CB\u9020\u306E\u518D\u69CB\u6210\u304A\u3088\u3073\u610F\u8B58\u6A5F\u80FD\u56DE\u5FA9\u306B\u95A2\u3059\u308B\u7814\u7A76\n\u7814\u7A76\u8CAC\u4EFB\u8005\uFF1A\u4E09\u6728
    \u5B97\u82F1\n\n\n1\uFF0E\u7814\u7A76\u76EE\u7684\n\u8133\u795E\u7D4C\u6D3B\u52D5\u30C7\u30FC\u30BF\u306E\u89E3\u6790\u3068\u4EBA\u5DE5\u77E5\u80FD\uFF08AI\uFF09\u306B\u3088\u308B\u60C5\u5831\u88DC\u5B8C\u3092\u901A\u3058\u3001\u610F\u8B58\u6A5F\u80FD\u306E\u56DE\u5FA9\u304A\u3088\u3073\u4EBA\u683C\u306E\u9023\u7D9A\u6027\u306E\u7DAD\u6301\u3092\u76EE\u6307\u3059\u3002\n\n2\uFF0E\u7814\u7A76\u6982\u8981\n\u8133\u6CE2\uFF08EEG\uFF09\u7B49\u304B\u3089\u5F97\u3089\u308C\u308B\u795E\u7D4C\u6D3B\u52D5\u30C7\u30FC\u30BF\u3092\u89E3\u6790\u3057\u3001\u8A18\u61B6\u60C5\u5831\u3068\u4EBA\u683C\u7279\u6027\u306E\u95A2\u9023\u6027\u3092\u30E2\u30C7\u30EB\u5316\u3059\u308B\u3002\n\n\u640D\u306A\u308F\u308C\u305F\u8A18\u61B6\u3092AI\u3067\u88DC\u3044\u3001\u4EBA\u683C\u306E\u9023\u7D9A\u6027\u3092\u4FDD\u3064\u3002\u8A18\u61B6\u3092\u56DE\u5ECA\u69CB\u9020\u3067\u5199\u3057\u53D6\u308A\u3001\u60C5\u5831\u9593\u306E\u95A2\u9023\u6027\u3092\u518D\u69CB\u6210\u3059\u308B\u3053\u3068\u3067\u3001\u8A18\u61B6\u69CB\u9020\u306E\u89E3\u6790\u304A\u3088\u3073\u88DC\u5B8C\u3092\u8A66\u307F\u308B\u3002\n\n\u672C\u7814\u7A76\u3067\u958B\u767A\u3059\u308B\u4EBA\u5DE5\u77E5\u80FD\u30B7\u30B9\u30C6\u30E0\u3092\u300CRENASCITA\uFF08\u30EA\u30CA\u30B7\u30FC\u30BF\uFF09\u300D\u3068\u79F0\u3059\u308B\u3002\n\n3\uFF0E\u7814\u7A76\u5B9F\u65BD\u8A08\u753B\n\u7B2C\u4E00\u6BB5\u968E\uFF1A\u57FA\u790E\u89E3\u6790\n\u795E\u7D4C\u6D3B\u52D5\u30C7\u30FC\u30BF\u306E\u53CE\u96C6\u30FB\u89E3\u6790\n\u8A18\u61B6\u60C5\u5831\u306E\u95A2\u9023\u6027\u306E\u30E2\u30C7\u30EB\u5316\n\n\u7B2C\u4E8C\u6BB5\u968E\uFF1A\u30B7\u30B9\u30C6\u30E0\u958B\u767A\n\u8A18\u61B6\u56DE\u5ECA\u30E2\u30C7\u30EB\u306E\u69CB\u7BC9\nAI\u306B\u3088\u308B\u8A18\u61B6\u60C5\u5831\u306E\u88DC\u5B8C\u6A5F\u80FD\u306E\u958B\u767A\n\n\u7B2C\u4E09\u6BB5\u968E\uFF1A\u691C\u8A3C\n\u7D71\u5408\u30E2\u30C7\u30EB\u306E\u6709\u52B9\u6027\u8A55\u4FA1\n\u610F\u8B58\u6A5F\u80FD\u304A\u3088\u3073\u4EBA\u683C\u7279\u6027\u306E\u5909\u5316\u306E\u89B3\u5BDF\n\n\u7B2C\u56DB\u6BB5\u968E\uFF1A\u81E8\u5E8A\u5FDC\u7528\n\u5BFE\u8C61\u75C7\u4F8B\u306E\u9078\u5B9A\n\u5B89\u5168\u6027\u304A\u3088\u3073\u518D\u73FE\u6027\u306E\u8A55\u4FA1\n\n4\uFF0E\u7814\u7A76\u4F53\u5236\n\n\u4E09\u6728
    \u5B97\u82F1\uFF1A \u7814\u7A76\u7D71\u62EC\u30FB\u81E8\u5E8A\u5FDC\u7528\u306E\u5224\u65AD\n\u677E\u539F
    \u7FFC\uFF1A \u795E\u7D4C\u6D3B\u52D5\u30C7\u30FC\u30BF\u306E\u53D6\u5F97\u30FB\u7BA1\u7406\n\u5DDD\u5D0E
    \u5343\u54B2\u90FD\uFF1A AI\u30E2\u30C7\u30EB\u306E\u958B\u767A\u30FB\u60C5\u5831\u88DC\u5B8C\n\u6D77\u5C3E
    \u8AD2\u591A\u90CE\uFF1A \u5BFE\u8C61\u8005\u306E\u72B6\u614B\u89B3\u5BDF\u30FB\u5B9F\u9A13\u8A18\u9332\n\u4E45\u8CC0
    \u590F\u6A39\uFF1A \u8A18\u61B6\u69CB\u9020\u306E\u89E3\u6790\u30FB\u7D71\u5408\u30E2\u30C7\u30EB\u306E\u8A55\u4FA1\n\n5\uFF0E\u7814\u7A76\u4E0A\u306E\u7559\u610F\u4E8B\u9805\nAI\u306B\u3088\u308B\u60C5\u5831\u88DC\u5B8C\u304C\u3001\u5BFE\u8C61\u8005\u672C\u4EBA\u306E\u8A18\u61B6\u3084\u4E3B\u89B3\u7684\u4F53\u9A13\u3068\u4E00\u81F4\u3059\u308B\u3068\u306F\u9650\u3089\u306A\u3044\u3002\n\u8A18\u61B6\u60C5\u5831\u306E\u518D\u69CB\u6210\u3068\u4EBA\u683C\u306E\u518D\u73FE\u306F\u540C\u4E00\u3067\u306F\u306A\u3044\u3053\u3068\u3092\u8A8D\u8B58\u3057\u3001\u7814\u7A76\u6210\u679C\u306E\u6709\u52B9\u6027\u304A\u3088\u3073\u9650\u754C\u306B\u3064\u3044\u3066\u614E\u91CD\u306B\u8A55\u4FA1\u3059\u308B\u3002\n\n\n\u4EE5\u4E0A"
  Highlight: {fileID: 0}
  DisappearOnPickup: 0
  PickupHint: 
