  RoomId: ward
  Id: girlfile
  DisplayName: "\u5C11\u5973\u306E\u30D5\u30A1\u30A4\u30EB"
  NoteTitle: "\u60A3\u8005\u756A\u53F7\u306E\u7121\u3044\u30D5\u30A1\u30A4\u30EB"
  NoteBody: "\u300A\u8A3A\u7642\u8A18\u9332\u300B\u3000\u60A3\u8005\u756A\u53F7:
    \u2500\u2500\n\n\u5199\u771F\u306F\u6C34\u306B\u6FE1\u308C\u305F\u3088\u3046\u306B\u6EF2\u3093\u3067\u3001\u9854\u304C\u898B\u3048\u306A\u3044\u3002\n\u5E74\u9F62\u306E\u6B04\u3082\u3001\u540D\u524D\u306E\u6B04\u3082\u3001\u8AAD\u3081\u306A\u3044\u3002\n\n\u7279\u8A18\u4E8B\u9805\u3060\u3051\u304C\u3001\u306F\u3063\u304D\u308A\u6B8B\u3063\u3066\u3044\u308B\u3002\n\u300C\u3054\u5BB6\u65CF:
    \u7236\u3002\u6BCE\u65E5\u9762\u4F1A\u306B\u6765\u3089\u308C\u308B\u300D\n\n\u2500\u2500\u5A18\u3060\u3002\n\u79C1\u306B\u306F\u3001\u5A18\u304C\u3044\u308B\u3002\u3053\u3053\u306B\u3001\u9810\u3051\u305F\u3002"
