  m_Script: {fileID: 11500000, guid: 0215d13445bdaa040ae19885078bf2e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: analysis
  Id: anomaly
  DisplayName: "\u7570\u5E38\u5831\u544A"
  NoteTitle: "\u8A18\u61B6\u62BD\u51FA\u8A66\u9A13\u306B\u304A\u3051\u308B\u7570\u5E38\u5831\u544A"
  NoteBody: "\u4EF6\u540D\uFF1A\u8A18\u61B6\u62BD\u51FA\u8A66\u9A13\u306B\u304A\u3051\u308B\u7570\u5E38\u5831\u544A\n\n\u9001\u4FE1\u8005\uFF1A\u4E45\u8CC0
    \u590F\u6A39\n\u5B9B\u5148\uFF1A\u4E09\u6728 \u5B97\u82F1\n\n\u4E09\u6728\u6240\u9577\n\n\u8A18\u61B6\u62BD\u51FA\u8A66\u9A13\u306B\u304A\u3044\u3066\u3001\u88C5\u7F6E\u88C5\u7740\u8005\u306E\u610F\u8B58\u304A\u3088\u3073\u8A18\u61B6\u6A5F\u80FD\u306B\u7570\u5E38\u304C\u78BA\u8A8D\u3055\u308C\u307E\u3057\u305F\u3002\n\u62BD\u51FA\u51E6\u7406\u4E2D\u3001\u88C5\u7740\u8005\u306B\u4E00\u6642\u7684\u306A\u610F\u8B58\u969C\u5BB3\u304C\u767A\u751F\u3002\u8A66\u9A13\u7D42\u4E86\u5F8C\u3082\u3001\u76F4\u524D\u306E\u884C\u52D5\u3084\u4F1A\u8A71\u306E\u4E00\u90E8\u3092\u601D\u3044\u51FA\u305B\u306A\u3044\u306A\u3069\u3001\u8A18\u61B6\u306E\u6B20\u843D\u304C\u78BA\u8A8D\u3055\u308C\u3066\u3044\u307E\u3059\u3002\n\n\u73FE\u6BB5\u968E\u3067\u306F\u75C7\u72B6\u3068\u8A18\u61B6\u62BD\u51FA\u51E6\u7406\u306E\u56E0\u679C\u95A2\u4FC2\u306F\u65AD\u5B9A\u3067\u304D\u307E\u305B\u3093\u3002\u3057\u304B\u3057\u3001\u8A18\u61B6\u60C5\u5831\u3092\u8AAD\u307F\u53D6\u308B\u904E\u7A0B\u3067\u3001\u5BFE\u8C61\u8005\u81EA\u8EAB\u306E\u8A18\u61B6\u306B\u3082\u5F71\u97FF\u304C\u53CA\u3093\u3067\u3044\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002\n\n\u3053\u306E\u307E\u307E\u672C\u756A\u898F\u6A21\u3067\u306E\u8A18\u61B6\u62BD\u51FA\u3092\u5B9F\u65BD\u3057\u305F\u5834\u5408\u3001\u88C5\u7740\u8005\u306E\u8133\u6A5F\u80FD\u306B\u56DE\u5FA9\u4E0D\u80FD\u306A\u640D\u50B7\u304C\u751F\u3058\u3001\u6700\u60AA\u306E\u5834\u5408\u3001\u8133\u6B7B\u306B\u81F3\u308B\u5371\u967A\u6027\u3082\u5426\u5B9A\u3067\u304D\u307E\u305B\u3093\u3002\n\u539F\u56E0\u306E\u7279\u5B9A\u3068\u5B89\u5168\u6027\u306E\u518D\u691C\u8A3C\u304C\u5B8C\u4E86\u3059\u308B\u307E\u3067\u3001\u672C\u756A\u8A66\u9A13\u3078\u306E\u79FB\u884C\u3092\u898B\u5408\u308F\u305B\u308B\u3088\u3046\u5F37\u304F\u8981\u8ACB\u3057\u307E\u3059\u3002\n\n\u4E45\u8CC0
    \u590F\u6A39"
