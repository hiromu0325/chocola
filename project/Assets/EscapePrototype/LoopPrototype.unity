  m_Script: {fileID: 11500000, guid: 0215d13445bdaa040ae19885078bf2e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: analysis
  Id: spec
  DisplayName: "\u30A2\u30EB\u30B4\u30EA\u30BA\u30E0\u4ED5\u69D8\u66F8"
  NoteTitle: "\u8A18\u61B6\u88DC\u5B8C\u30A2\u30EB\u30B4\u30EA\u30BA\u30E0\u4ED5\u69D8\u66F8"
  NoteBody: "\u8A18\u61B6\u88DC\u5B8C\u30A2\u30EB\u30B4\u30EA\u30BA\u30E0\u4ED5\u69D8\u66F8\n\n\u6587\u66F8\u756A\u53F7\uFF1AMNR-DS-0012\n\u5BFE\u8C61\u30B7\u30B9\u30C6\u30E0\uFF1ARENASCITA\uFF08\u30EA\u30CA\u30B7\u30FC\u30BF\uFF09\n\u7BA1\u7406\u8CAC\u4EFB\u8005\uFF1A\u4E09\u6728
    \u5B97\u82F1\n\n1\uFF0E\u6982\u8981\n\u6B20\u640D\u3057\u305F\u8A18\u61B6\u60C5\u5831\u3092AI\u306B\u3088\u3063\u3066\u63A8\u5B9A\u30FB\u88DC\u5B8C\u3057\u3001\u8A18\u61B6\u69CB\u9020\u306E\u518D\u69CB\u6210\u3092\u884C\u3046\u3002\n\n2\uFF0E\u51E6\u7406\u624B\u9806\n\u60C5\u5831\u53D6\u5F97\uFF1A\u795E\u7D4C\u6D3B\u52D5\u30C7\u30FC\u30BF\u304B\u3089\u8A18\u61B6\u306B\u95A2\u9023\u3059\u308B\u60C5\u5831\u3092\u62BD\u51FA\u3059\u308B\u3002\n\u95A2\u9023\u4ED8\u3051\uFF1A\u4EBA\u7269\u3001\u51FA\u6765\u4E8B\u3001\u611F\u60C5\u3001\u6642\u9593\u3001\u5834\u6240\u306A\u3069\u306E\u60C5\u5831\u3092\u76F8\u4E92\u306B\u63A5\u7D9A\u3059\u308B\u3002\n\u6B20\u640D\u88DC\u5B8C\uFF1A\u95A2\u9023\u3059\u308B\u8A18\u61B6\u3092\u3082\u3068\u306B\u3001\u4E0D\u8DB3\u3057\u3066\u3044\u308B\u60C5\u5831\u3092\u63A8\u5B9A\u3059\u308B\u3002\n\u69CB\u9020\u518D\u69CB\u6210\uFF1A\u88DC\u5B8C\u3057\u305F\u60C5\u5831\u3092\u8A18\u61B6\u56DE\u5ECA\u30E2\u30C7\u30EB\u306B\u7D71\u5408\u3059\u308B\u3002\n\u6574\u5408\u6027\u691C\u8A3C\uFF1A\u4ED6\u306E\u8A18\u61B6\u3068\u306E\u77DB\u76FE\u3092\u78BA\u8A8D\u3057\u3001\u7D50\u679C\u3092\u8A18\u9332\u3059\u308B\u3002\n\n3\uFF0E\u6CE8\u610F\u4E8B\u9805\n\u8A18\u61B6\u9593\u306E\u6574\u5408\u6027\u304C\u9AD8\u3044\u3053\u3068\u306F\u3001\u88DC\u5B8C\u3055\u308C\u305F\u60C5\u5831\u304C\u4E8B\u5B9F\u3067\u3042\u308B\u3053\u3068\u3092\u4FDD\u8A3C\u3057\u306A\u3044\u3002\n\n\u672C\u30B7\u30B9\u30C6\u30E0\u306F\u8A18\u61B6\u3092\u518D\u69CB\u6210\u3059\u308B\u3082\u306E\u3067\u3042\u308A\u3001\u672C\u4EBA\u306E\u5B9F\u969B\u306E\u7D4C\u9A13\u3092\u5B8C\u5168\u306B\u5FA9\u5143\u3059\u308B\u3082\u306E\u3067\u306F\u306A\u3044\u3002\n\n\u4EE5\u4E0A\n\u6587\u66F8\u7BA1\u7406\u533A\u5206\uFF1A\u7814\u7A76\u6240\u5185\u90E8\u8CC7\u6599\n\n\u6B04\u5916\u306E\u66F8\u304D\u8FBC\u307F:\n\u300C\u88DC\u5B8C\u3055\u308C\u305F\u8A18\u61B6\u306F\u3001\u672C\u5F53\u306B\u672C\u4EBA\u306E\u3082\u306E\u304B\uFF1F\u300D\n\u300C\u672C\u4EBA\u3092\u672C\u4EBA\u305F\u3089\u