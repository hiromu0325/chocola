  m_Script: {fileID: 11500000, guid: 0215d13445bdaa040ae19885078bf2e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: data_room
  Id: minutes
  DisplayName: "\u8B70\u4E8B\u9332"
  NoteTitle: "\u505C\u6B62\u8981\u6C42\u306E\u8B70\u4E8B\u9332"
  NoteBody: "\u300A\u7DCA\u6025\u4F1A\u8B70 \u8B70\u4E8B\u9332\u300B\u3000\u8D77\u6848:
    \u9ED2\u7530\n\u65E5\u6642: 4\u670818\u65E5\u301C19\u65E5\uFF082\u65E5\u9593\uFF09\n\u51FA\u5E2D:
    \u9ED2\u7530\u30FB\u4F50\u4F2F\u30FB\u6C34\u91CE\n\u6B20\u5E2D: \u6240\u9577\uFF08\u5B66\u4F1A\u51FA\u5F35\u306E\u305F\u3081\u672D\u5E4C\u306B\u6EDE\u5728\u3002\n\u3000\u3000\u3000
    19\u65E5\u591C\u307E\u3067\u623B\u3089\u305A\u3001\u96FB\u8A71\u3067\u53C2\u52A0\uFF09\n\n\u300C\u30B7\u30B9\u30C6\u30E0\u306F\u767B\u9332\u3055\u308C\u305F\u8133\u60C5\u5831\u3092\n\u3000\u5358\u306A\u308B\u30C7\u30FC\u30BF\u3067\u306F\u306A\u304F\u3001\u4EBA\u683C\u30E2\u30C7\u30EB\u3068\u3057\u3066\n\u3000\u6271\u3044\u59CB\u3081\u3066\u3044\u308B\u3002\u3053\u308C\u306F\u6CBB\u7642\u3067\u306F\u306A\u3044\u3002\n\u3000\u76F4\u3061\u306B\u904B\u7528\u3092\u505C\u6B62\u3059\u3079\u304D\u3060\u300D\n\n\u30FB\u6240\u9577\uFF08\u96FB\u8A71\uFF09:
    \u4FDD\u7559\n\u30FB\u4F50\u4F2F: \u691C\u8A3C\u306B\u6642\u9593\u3092\u8981\u3059\u308B\u3068\u767A\u8A00\n\n\u2026\u2026\u9ED2\u7530\u3002\u540D\u7C3F\u306E\u4E0A\u5E2D\u7814\u7A76\u54E1\u3002\n\u3053\u306E\u65BD\u8A2D\u3067\u3001\u6700\u521D\u306B\u300C\u6B62\u3081\u308D\u300D\u3068\u8A00\u3063\u305F\u4EBA\u3002"
