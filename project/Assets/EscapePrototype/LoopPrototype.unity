  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: system_room
  Id: devlog
  DisplayName: "\u958B\u767A\u8A18\u9332"
  NoteTitle: "\u958B\u767A\u8A18\u9332\u30FB\u6CBB\u7642\u624B\u9806"
  NoteBody: "\u300A\u6CBB\u7642\u624B\u9806 \u5168\u6587\u300B\n\n1. \u63D0\u4F9B\u4F53\u306E\u8133\u60C5\u5831\u3092\u63A1\u53D6\u3057\u3001BRAIN
    DATA\u3068\u3057\u3066\u767B\u9332\n2. \u5BFE\u8C61\u8005\uFF08\u60A3\u8005\uFF09\u306E\u6B20\u640D\u9818\u57DF\u3078\u5199\u50CF\u30FB\u88DC\u5B8C\n3.
    \u5BFE\u8C61\u8005\u306E\u4EBA\u683C\u304C\u518D\u69CB\u6210\u3055\u308C\u308B\u307E\u3067\u53CD\u5FA9\n\n\u5099\u8003:
    \u5B8C\u5168\u306A\u88DC\u5B8C\u306B\u306F\u63D0\u4F9B\u4F53\u306E\u8133\u60C5\u5831\u3092100%\u53D6\u5F97\n\u3059\u308B\u5FC5\u8981\u304C\u3042\u308B\u3002100%\u53D6\u5F97\u5F8C\u306E\u899A\u9192\u306F\u4E0D\u53EF\n\uFF08\u904B\u7528\u624B\u9806\u66F8
    4-3 \u53C2\u7167\uFF09\u3002\n\n\u2500\u2500100%\u3002\u899A\u9192\u306F\u3001\u4E0D\u53EF\u3002\n\u767B\u9332\u306F\u30013\u4EF6\u3060\u3063\u305F\u3002"
