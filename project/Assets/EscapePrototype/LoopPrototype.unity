  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: system_room
  Id: devlog
  DisplayName: "\u958B\u767A\u8A18\u9332"
  NoteTitle: "\u958B\u767A\u8A18\u9332\u30FB\u6CBB\u7642\u624B\u9806"
  NoteBody: "\u300A\u6CBB\u7642\u624B\u9806 \u5168\u6587\u300B\n\n1. \u63D0\u4F9B\u4F53\u306E\u8133\u60C5\u5831\u3092\u63A1\u53D6\u3057\u3001BRAIN
