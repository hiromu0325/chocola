  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: kuroda_home
  Id: lastrec
  DisplayName: "\u5BFE\u5CD9\u306E\u8A18\u9332"
  NoteTitle: "\u6700\u5F8C\u306E\u5BFE\u5CD9\u306E\u8A18\u9332\uFF08\u7834\u640D\uFF09"
  NoteBody: "\u300AIC\u30EC\u30B3\u30FC\u30C0\u30FC \u5FA9\u5143\u65AD\u7247\u300B\n\n\u9ED2\u7530:\u300C\u3082\u3046\u5206\u304B\u3063\u3066\u3044\u308B\u3093\u3067\u3059\u3002\u3042\u306A\u305F\u3067\u3057\u3087\u3046\u300D\n\u3000\u3000
    \u300C\u2500\u2500\u3042\u306A\u305F\u306F\u5A18\u3092\u6551\u3044\u305F\u3044\u3093\u3058\u3083\u306A\u3044\u3002\n\u3000\u3000\u3000
    \u5A18\u3092\u5931\u3046\u3053\u3068\u3092\u3001\u53D7\u3051\u5165\u308C\u3089\u308C\u306A\u3044\u3060\u3051\u3060\u300D\n\n\uFF08\u9577\u3044\u6C88\u9ED9\uFF09\n\n\u9ED2\u7530:\u300C\u2026\u2026\u305D\u3046\u304B\u3002\u305D\u306E\u9854\u304C\u3001\u7B54\u3048\u304B\u300D\n\n\u8A18\u9332\u306F\u3053\u3053\u3067\u7834\u640D\u3057\u3066\u3044\u308B\u3002\n\u5F7C\u306F\u6700\u5F8C\u307E\u3067\u3001\u9003\u3052\u306A\u304B\u3063\u305F\u3002"
  Highlight: {fileID: 0}
  DisappearOnPickup: 0
  PickupHint: 
