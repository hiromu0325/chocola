  m_Script: {fileID: 11500000, guid: 0215d13445bdaa040ae19885078bf2e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EscapeProto.LoopFindable
  RoomId: study
  Id: pcchat
  DisplayName: "\u6240\u9577\u306EPC"
  NoteTitle: "\u6240\u5185\u30C1\u30E3\u30C3\u30C8 \u30ED\u30B0\uFF08\u5FA9\u5143\uFF09"
  NoteBody: "\u300A\u6240\u5185\u30C1\u30E3\u30C3\u30C8 \u30ED\u30B0\uFF08\u5FA9\u5143\uFF09\u300B\n\n\u4F50\u85E43:
    \u4F8B\u306E\u4EF6\u3001\u307E\u3060\u7D9A\u3051\u308B\u3064\u3082\u308A\u3067\u3059\u304B\u3002\n\u3000\u3000\u3000
    \u502B\u7406\u59D4\u54E1\u4F1A\u306F\u7D76\u5BFE\u306B\u901A\u308A\u307E\u305B\u3093\n\u4F50\u85E41:
    \u901A\u3059\u5FC5\u8981\u306F\u306A\u3044\u3002\u3042\u306E\u5B50\u306B\u306F\u3082\u3046\u6642\u9593\u304C\u306A\u3044\n\u6240\u9577
    : \u4F50\u85E41\u304F\u3093\u3002\u7B2C\u4E09\u7CFB\u7D71\u306E\u63A5\u7D9A\u5B9F\u9A13\u306F\u51CD\u7D50\u3060\u3002\n\u3000\u3000\u3000
    \u3053\u308C\u306F\u547D\u4EE4\u3060\u3088\n\u4F50\u85E41: \u2026\u2026\u3042\u306A\u305F\u9054\u306F\u3001\u79C1\u306E\u7814\u7A76\u3092\u596A\u3063\u3066\n\u3000\u3000\u3000
    \u81EA\u5206\u306E\u3082\u306E\u306B\u3059\u308B\u6C17\u306A\u3093\u3060\n\u4F50\u85E43:
    \u8AB0\u3082\u305D\u3093\u306A\u3053\u3068\u306F\u8A00\u3063\u3066\u3044\u306A\u3044\n\u4F50\u85E41:
    \u3082\u3046\u3044\u3044\u3002\u8A18\u9332\u3082\u88C5\u7F6E\u3082\u3001\u4F55\u3082\u6E21\u3055\u306A\u3044\n\n\uFF08\u3053\u308C\u4EE5\u964D\u306E\u30ED\u30B0\u306F\u524A\u9664\u3055\u308C\u3066\u3044\u308B\uFF09"
