    - 
  - id: lock/mizuno_apart.pcfile.success_body
    values:
    - "\u30C7\u30B9\u30AF\u30C8\u30C3\u30D7\u306B\u3001\u3072\u3068\u3064\u3060\u3051\u30D5\u30A1\u30A4\u30EB\u3002\n\u300C\u7B2C12\u7814\u7A76\u5BA4
