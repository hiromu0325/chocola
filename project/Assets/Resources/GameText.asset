    - 
  - id: lock/kuroda_home.verdict.title
    values:
    - "\u9ED2\u7530\u306E\u624B\u5E33\u3000\u2500\u2500 \u767D\u7D19\u306E\u30DA\u30FC\u30B8
      \u2500\u2500"
    - 
  - id: lock/kuroda_home.verdict.body
    values:
    - "\u3042\u306E\u53E3\u8AD6\u3067\u3001\u6012\u9CF4\u3063\u3066\u3044\u305F\u306E\u306F\u8AB0\u3060\u3063\u305F\u306E\u304B\u3002\n\u79C1\u306F\u3001\u7B54\u3048\u3092\u66F8\u304D\u8FBC\u307E\u306A\u3051\u308C\u3070\u306A\u3089\u306A\u3044\u3002"
    - 
  - id: lock/kuroda_home.verdict.notenough
    values:
