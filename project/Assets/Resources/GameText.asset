    - "\u75C5\u9662\u306E\u30D9\u30C3\u30C9\u306E\u8107\u306B\u3001\u5C0F\u3055\u306A\u5F71\u304C\u7ACB\u3063\u3066\u3044\u308B\u3002\n\u7720\u3063\u305F\u307E\u307E\u306E\u8AB0\u304B\u306B\u3001\u305A\u3063\u3068\u8A71\u3057\u304B\u3051\u3066\u3044\u308B\u3002\n\u8FD4\u4E8B\u306F\u306A\u3044\u3002\u305D\u308C\u3067\u3082\u3001\u6BCE\u65E5\u3002\n\u2500\u2500\u5F7C\u5973\u306E\u539F\u70B9\u304C\u3001\u3053\u3053\u306B\u3042\u308B\u3002"
