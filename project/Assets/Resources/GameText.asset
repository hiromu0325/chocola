    - 
  - id: room/lab.chapter
    values:
    - "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u30003\u7BC0"
    - 
  - id: doc/lab.summary.name
    values:
    - "\u7814\u7A76\u6982\u8981"
    - 
  - id: doc/lab.summary.title
    values:
    - "\u7814\u7A76\u6982\u8981"
    - 
  - id: doc/lab.summary.body
    values:
    - "\u300A\u5C0F\u5DDD\u8133\u795E\u7D4C\u7DCF\u5408\u7814\u7A76\u6240 \u7814\u7A76\u6982\u8981\u300B\n\n\u76EE\u7684:
      \u640D\u50B7\u3057\u305F\u8A18\u61B6\u9818\u57DF\u3092AI\u3067\u88DC\u5B8C\u3057\u3001\n\u3000\u3000\u3000\u4EBA\u683C\u306E\u9023\u7D9A\u6027\u3092\u7DAD\u6301\u3059\u308B\n\n\u624B\u9806:\n\u30001.
      \u88AB\u9A13\u4F53\u306E\u8A18\u61B6\u3092\u56DE\u5ECA\u69CB\u9020\u3068\u3057\u3066\u5199\u50CF\n\u30002.
      \u6B20\u640D\u533A\u753B\u306BAI\u751F\u6210\u306E\u8A18\u61B6\u3092\u79FB\u690D\n\u30003.
      \u899A\u9192\u5F8C\u3001\u9F5F\u9F6C\u306E\u6709\u7121\u3092\u89B3\u5BDF\n\n\u203B\u7B2C4\u9805\u4EE5\u964D\u306F\u7834\u68C4\u3055\u308C\u3066\u3044\u308B"
    - 
  - id: doc/lab.members.name
    values:
    - "\u793E\u54E1\u540D\u7C3F"
    - 
  - id: doc/lab.members.title
    values:
    - "\u793E\u54E1\u540D\u7C3F"
    - 
  - id: doc/lab.members.body
    values:
    - "\u300A\u793E\u54E1\u540D\u7C3F\u300B\n\n\u3000\u4F50\u4F2F \u6052\u4E00\u3000\u4E3B\u4EFB\u7814\u7A76\u54E1\u88DC\u4F50\uFF08\u5199\u771F\u3042\u308A\uFF09\n\u3000\u6C34\u91CE
      \u7F8E\u5948\u3000\u81E8\u5E8A\u7814\u7A76\u54E1\u3000\u3000\uFF3B\u9854\u30FB\u5224\u8AAD\u4E0D\u80FD\uFF3D\n\u3000\u9ED2\u7530
      \u6052\u4E00\u3000\u4E0A\u5E2D\u7814\u7A76\u54E1\u3000\u3000\uFF3B\u9854\u30FB\u5224\u8AAD\u4E0D\u80FD\uFF3D\n\u3000\u2500\u2500\u2500\u2500
      \u3000\u6240\u9577\u3000\u3000\u3000\u3000\u3000\uFF3B\u9854\u30FB\u5224\u8AAD\u4E0D\u80FD\uFF3D\n\n3\u4EBA\u5206\u306E\u9854\u5199\u771F\u306F\u85AC\u54C1\u3067\u6EB6\u304B\u3055\u308C\u305F\u3088\u3046\u306B\n\u9ED2\u304F\u6EF2\u3093\u3067\u3044\u308B\u3002\u7121\u4E8B\u306A\u306E\u306F\u4F50\u4F2F\u3001\u305F\u3060\u4E00\u4EBA\u3002\n\u2026\u2026\u3053\u306E\u9854\u3001\u3069\u3053\u304B\u3067\u3002"
    - 
  - id: doc/lab.toy.name
    values:
    - "\u6298\u308A\u7D19\u306E\u9DB4"
    - 
  - id: doc/lab.toy.title
    values:
    - "\u601D\u3044\u51FA\u306E\u65AD\u7247\uFF1A\u6298\u308A\u7D19\u306E\u9DB4"
    - 
  - id: doc/lab.toy.body
    values:
    - "\u767D\u8863\u306E\u4EBA\u305F\u3061\u304C\u3001\u9806\u756A\u306B\u6298\u3063\u3066\u304F\u308C\u305F\u3002\n\u75C5\u5BA4\u306E\u30AB\u30FC\u30C6\u30F3\u30EC\u30FC\u30EB\u306B\u3001\u305A\u3089\u308A\u3068\u4E26\u3093\u3060\u9DB4\u3002\n\u898B\u4E0A\u3052\u308B\u3068\u3001\u3086\u3089\u3086\u3089\u63FA\u308C\u3066\u3044\u305F\u3002"
    - 
  - id: doc/lab.toy.hint
    values:
    - "\u5A18\u306E\u8A18\u61B6"
    - 
  - id: room/study.name
    values:
    - "\u6240\u9577\u306E\u66F8\u658E"
    - 
  - id: room/study.chapter
    values:
    - "1\u7AE0\u300E\u4F50\u4F2F\u6052\u4E00\u300F\u3000\u2500 \u8D77 \u2500"
    - 
  - id: doc/study.document.name
    values:
    - "\u6587\u66F8"
    - 
  - id: doc/study.document.title
    values:
    - "\u7814\u7A76\u6587\u66F8\uFF08\u5199\u3057\uFF09"
    - 
  - id: doc/study.document.body
    values:
    - "\u300A\u88AB\u9A13\u4F53\u7D4C\u904E\u5831\u544A \u629C\u7C8B\u300B\n\n\u30FB\u88AB\u9A13\u4F53\u306F\u81EA\u8EAB\u3092\u300E\u7814\u7A76\u54E1\u300F\u3068\u8A8D\u8B58\u3057\u3066\u3044\u308B\n\u30FB\u8A18\u61B6\u306E\u518D\u751F\u6642\u3001\u540C\u4E00\u306E\u7A7A\u9593\u3092\u53CD\u5FA9\u3057\u3066\u8A8D\u77E5\u3059\u308B\n 
      \uFF08\u56DE\u5ECA\u72B6\u306E\u69CB\u9020\u3068\u3057\u3066\u89B3\u6E2C\u3055\u308C\u308B\uFF09\n\u30FB\u79FB\u690D\u3057\u305FAI\u9818\u57DF\u304C\u5BBF\u4E3B\u306E\u8A18\u61B6\u3092\u518D\u69CB\u6210\u3057\u3066\u3044\u308B\n 
      \u53EF\u80FD\u6027\u304C\u3042\u308B\n\n\u5831\u544A\u8005\u540D\u306E\u6B04\u306F\u9ED2\u304F\u5857\u308A\u6F70\u3055\u308C\u3066\u3044\u308B\u3002"
    - 
  - id: doc/study.scrap.name
    values:
    - "\u624B\u5E33\u306E\u5207\u308C\u7AEF"
    - 
  - id: doc/study.scrap.title
    values:
    - "\u4E3B\u4EFB\u306E\u624B\u5E33\u306E\u5207\u308C\u7AEF"
    - 
  - id: doc/study.scrap.body
    values:
    - "\u300A\u624B\u5E33\u306E\u5207\u308C\u7AEF\u300B\n\n\u30004/2\u3000\u4F50\u4F2F\u3068\u9762\u8AC7\u3002\n\u3000\u3000\u3000
      \u4F8B\u306E\u4EF6\u3001\u4F50\u4F2F\u306B\u3060\u3051\u306F\u8A71\u3057\u3066\u304A\u304F\u3002\n\u3000\u3000\u3000
      \u5F7C\u306A\u3089\u6C17\u3065\u3044\u3066\u3044\u308B\u3002\n\n\u30004/9\u3000\u4F50\u4F2F\u3088\u308A\u5831\u544A\u3002\u300C\u4ECA\u306F\u7D50\u8AD6\u3092\u51FA\u3059\u306A\u300D\u3068\n\u3000\u3000\u3000
      \u4F1D\u3048\u305F\u3002\u6642\u9593\u304C\u8981\u308B\u3002\n\n\u7834\u308A\u53D6\u3089\u308C\u305F\u30DA\u30FC\u30B8\u3002\u6240\u9577\u3068\u4F50\u4F2F\u2500\u2500\n\u4E8C\u4EBA\u3060\u3051\u304C\u5171\u6709\u3057\u3066\u3044\u305F\u300C\u4F8B\u306E\u4EF6\u300D\u3068\u306F\u3002"
    - 
  - id: doc/study.invite.name
    values:
    - "\u5C01\u66F8"
    - 
  - id: doc/study.invite.title
    values:
    - "\u62DB\u8058\u72B6"
    - 
  - id: doc/study.invite.body
    values:
    - "\u300A\u62DB\u8058\u72B6\u300B\u30002015\u5E743\u670825\u65E5\n\n\u4E8C\u5BAE\u79C0\u6A39
      \u69D8\n\n\u8CB4\u6BBF\u306E\u60C5\u5831\u79D1\u5B66\u306B\u304A\u3051\u308B\u696D\u7E3E\u3001\u306A\u3089\u3073\u306B\n\u8ABF\u67FB\u696D\u3067\u306E\u3054\u7D4C\u9A13\u3092\u9AD8\u304F\u8A55\u4FA1\u3057\u3001\u5F53\u7814\u7A76\u6240\u306E\n\u7279\u5225\u7814\u7A76\u54E1\u3068\u3057\u3066\u304A\u8FCE\u3048\u3057\u305F\u304F\u5B58\u3058\u307E\u3059\u3002\n\n\u3000\u5C0F\u5DDD\u8133\u795E\u7D4C\u7DCF\u5408\u7814\u7A76\u6240\u3000\u6240\u9577\n\n\u2500\u2500\u4E8C\u5BAE\u79C0\u6A39\u3002\n\u305D\u306E\u540D\u524D\u3092\u76EE\u3067\u306A\u305E\u3063\u305F\u77AC\u9593\u3001\u80F8\u306E\u5965\u304C\u8ECB\u3093\u3060\u3002\n\u79C1\u3060\u3002\u79C1\u306E\u540D\u524D\u3060\u3002\u60C5\u5831\u79D1\u5B66\u3068\u3001\u63A2\u5075\u3002"
    - 
