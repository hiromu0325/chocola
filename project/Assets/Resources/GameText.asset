    - 
  - id: echo/argue_saeki.body
    values:
    - "\u5C45\u9593\u306E\u9685\u3067\u3001\u4E8C\u3064\u306E\u5F71\u304C\u8DDD\u96E2\u3092\u53D6\u3063\u3066\u5411\u304B\u3044\u5408\u3063\u3066\u3044\u308B\u3002\n\u58F0\u306F\u4F4E\u304F\u6291\u3048\u3089\u308C\u3001\u6642\u6298\u3001\u7247\u65B9\u304C\u9759\u304B\u306B\u3046\u306A\u305A\u304F\u3002\n\u6FC0\u3057\u305F\u8A00\u8449\u306F\u3069\u3053\u306B\u3082\u306A\u3044\u3002\u2500\u2500\u51B7\u9759\u306A\u3001\u8B70\u8AD6\u3002\n\u4F50\u4F2F\u306E\u8A18\u61B6\u306E\u4E2D\u3067\u306F\u3001\u305D\u3046\u3060\u3063\u305F\u3002"
    - 
  - id: echo/saeki_wife.title
    values:
    - "\u6B8B\u97FF\uFF1A\u4E8C\u4EBA\u5206\u306E\u98DF\u5668\uFF08\u59BB\u306E\u8A18\u61B6\uFF09"
    - 
  - id: echo/saeki_wife.body
    values:
    - "\u30C6\u30FC\u30D6\u30EB\u306E\u8107\u306B\u3001\u5973\u6027\u306E\u5F71\u304C\u7ACB\u3063\u3066\u3044\u308B\u3002\n\u30AB\u30C3\u30D7\u3092\u4E8C\u3064\u7F6E\u304D\u3001\u4E00\u3064\u3092\u5411\u304B\u3044\u306E\u5E2D\u3078\u3002\n\u305D\u306E\u307E\u307E\u3001\u3058\u3063\u3068\u5F85\u3063\u3066\u3044\u308B\u3002\u8AB0\u3082\u3001\u5EA7\u3089\u306A\u3044\u3002\n\u53E3\u8AD6\u3082\u7814\u7A76\u3082\u77E5\u3089\u306A\u3044\u5BB6\u65CF\u306E\u6642\u9593\u304C\u3001\u3053\u3053\u3067\u6B62\u307E\u3063\u3066\u3044\u308B\u3002"
    - 
