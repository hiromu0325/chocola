    - "\u2026\u2026\u3053\u306E\u5834\u9762\u3092\u3001\u77E5\u3063\u3066\u3044\u308B\u3002\u4F50\u4F2F\u306E\u5BB6\u3067\u898B\u305F\u3001\u3042\u306E\u53E3\u8AD6\u3060\u3002\n\u3060\u304C\u3001\u307E\u308B\u3067\u9055\u3046\u3002\n\u5411\u304B\u3044\u306E\u5F71\u306F\u4E00\u56DE\u308A\u5927\u304D\u304F\u3001\u8986\u3044\u304B\u3076\u3055\u308B\u3088\u3046\u306B\u8FEB\u308A\u3001\n\u5272\u308C\u305F\u58F0\u3092\u5F35\u308A\u4E0A\u3052\u3066\u3044\u308B\u3002\u3082\u3046\u7247\u65B9\u306E\u5F71\u306F\n\u58C1\u969B\u307E\u3067\u9000\u304C\u3063\u3066\u3001\u7E2E\u3053\u307E\u3063\u3066\u3044\u308B\u3002\n\n\u540C\u3058\u5834\u9762\u306E\u3001\u306F\u305A\u3060\u3002\n\u2500\u2500\u8A18\u61B6\u306F\u3001\u3053\u3093\u306A\u306B\u3082\u6B6A\u3080\u3002\n\u306A\u3089\u3002\u79C1\u304C\u3053\u3053\u307E\u3067\u898B\u3066\u304D\u305F\u8A18\u61B6\u306F\u3001\u3069\u3046\u306A\u3093\u3060\u3002"
