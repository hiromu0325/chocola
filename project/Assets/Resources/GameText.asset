    values:
    - "\u8133\u795E\u7D4C\u89E3\u6790\u5BA4"
    - 
  - id: room/analysis.chapter
    values:
    - "1\u7AE0\u300E\u4F50\u4F2F\u6052\u4E00\u300F\u3000\u2500 \u8EE2 \u2500"
    - 
  - id: doc/analysis.helmet.name
    values:
    - "\u30D8\u30EB\u30E1\u30C3\u30C8\u578B\u30B9\u30AD\u30E3\u30F3\u88C5\u7F6E"
    - 
  - id: doc/analysis.helmet.title
    values:
    - "\u30D8\u30EB\u30E1\u30C3\u30C8\u578B\u30B9\u30AD\u30E3\u30F3\u88C5\u7F6E"
    - 
  - id: doc/analysis.helmet.body
    values:
    - "\u982D\u306B\u3059\u3063\u307D\u308A\u88AB\u305B\u308B\u3001\u9ED2\u3044\u534A\u7403\u306E\u30D8\u30EB\u30E1\u30C3\u30C8\u3002\n\u5185\u5074\u306B\u306F\u7121\u6570\u306E\u96FB\u6975\u3002\u984E\u306E\u56FA\u5B9A\u30D9\u30EB\u30C8\u304C\u4ED8\u3044\u3066\u3044\u308B\u3002\n\n\u88C5\u7F6E\u306E\u30E9\u30D9\u30EB:\n\u300C\u88C5\u7740\u4E2D\u306F\u5F37\u3044\u4E0D\u5FEB\u611F\u3092\u4F34\u3044\u307E\u3059\u3002\n\u3000\u88AB\u9A13\u8005\u304C\u8010\u3048\u3089\u308C\u306A\u3044\u5834\u5408\u306F\u76F4\u3061\u306B\u4E2D\u65AD\u3059\u308B\u3053\u3068\u300D\n\n\u30D9\u30EB\u30C8\u306E\u5185\u5074\u306B\u3001\u722A\u3067\u5F15\u3063\u63BB\u3044\u305F\u3088\u3046\u306A\u8DE1\u3002\n\u2026\u2026\u8AB0\u304B\u304C\u3001\u5916\u305D\u3046\u3068\u3057\u305F\u8DE1\u3060\u3002"
    - 
  - id: doc/analysis.idcard.name
    values:
    - "\u8077\u54E1\u8A3C"
    - 
  - id: doc/analysis.idcard.title
    values:
    - "\u8077\u54E1\u8A3C\uFF08\u4F50\u4F2F\u6052\u4E00\uFF09"
    - 
  - id: doc/analysis.idcard.body
    values:
    - "\u300A\u8077\u54E1\u8A3C\u300B\u3000\u5C0F\u5DDD\u8133\u795E\u7D4C\u7DCF\u5408\u7814\u7A76\u6240\n\n\u3000\u6C0F\u540D:
      \u4F50\u4F2F \u6052\u4E00\n\u3000\u5F79\u8077: \u4E3B\u4EFB\u7814\u7A76\u54E1\u88DC\u4F50\n\u3000\u62C5\u5F53:
      \u88DC\u5B8C\u30A2\u30EB\u30B4\u30EA\u30BA\u30E0\n\n\u540D\u7C3F\u3067\u552F\u4E00\u9854\u304C\u6B8B\u3063\u3066\u3044\u305F\u7537\u3002\n\u305D\u3057\u3066\u2500\u2500\u3042\u306E\u7570\u5F62\u3068\u3001\u540C\u3058\u9854\u3002"
    - 
  - id: doc/analysis.plan.name
    values:
    - "\u7814\u7A76\u8A08\u753B\u66F8"
    - 
  - id: doc/analysis.plan.title
    values:
    - "\u30EA\u30CA\u30B7\u30FC\u30BF\u7814\u7A76\u8A08\u753B\u66F8"
    - 
  - id: doc/analysis.plan.body
    values:
    - "\u300ARENASCITA \u7814\u7A76\u8A08\u753B\u66F8 \u8868\u7D19\u300B\n\n\u5BFE\u8C61:
      \u9077\u5EF6\u6027\u610F\u8B58\u969C\u5BB3\uFF08\u3044\u308F\u3086\u308B\u690D\u7269\u72B6\u614B\uFF09\n\u65B9\u91DD:
      \u640D\u50B7\u3057\u305F\u8133\u306E\u8A18\u61B6\u30FB\u4EBA\u683C\u91CE\u3092\n\u3000\u3000\u3000\u5916\u90E8\u3088\u308A\u88DC\u5B8C\u3057\u3001\u610F\u8B58\u306E\u518D\u69CB\u6210\u3092\u4FC3\u3059\n\n\u300A\u30B9\u30AD\u30E3\u30F3\u624B\u9806
      \u629C\u7C8B\u300B\n\u30FB\u8133\u60C5\u5831\u306F\u30D8\u30EB\u30E1\u30C3\u30C8\u578B\u30B9\u30AD\u30E3\u30F3\u88C5\u7F6E\u3067\u53D6\u5F97\u3059\u308B\n\u30FB\u30B9\u30AD\u30E3\u30F3\u306F\u5F37\u3044\u4E0D\u5FEB\u611F\u3092\u4F34\u3044\u3001\u899A\u9192\u4E0B\u30FB\u7761\u7720\u4E0B\u3067\u306F\n\u3000\u6B63\u5E38\u306A\u30C7\u30FC\u30BF\u304C\u53D6\u308C\u306A\u3044\u3002\u6A5F\u80FD\u505C\u6B62\u85AC\u3067\u8133\u306E\n\u3000\u751F\u547D\u7DAD\u6301\u4EE5\u5916\u3092\u6B62\u3081\u305F\u72B6\u614B\u3067\u884C\u3046\u3053\u3068\n\u30FB\u53D6\u5F97\u5F8C\u306F\u6A5F\u80FD\u56DE\u5FA9\u85AC\u3067\u899A\u9192\u3055\u305B\u308B\u3002\u305F\u3060\u3057\n\u3000\u8A18\u61B6\u3068\u610F\u8B58\u306E\u6DF7\u6FC1\u304C\u751F\u3058\u308B\uFF08\u5F8C\u8FF0
      4-3\uFF09\n\n\u2500\u2500\u30EA\u30CA\u30B7\u30FC\u30BF\u3002\u30A4\u30BF\u30EA\u30A2\u8A9E\u3067\u300C\u518D\u8A95\u300D\u3002\n\u3053\u306E\u97FF\u304D\u3092\u3001\u79C1\u306F\u77E5\u3063\u3066\u3044\u308B\u3002\n\u7948\u308B\u3088\u3046\u306B\u53E3\u306B\u3057\u305F\u3053\u3068\u304C\u3001\u3042\u308B\u3002"
    - 
  - id: doc/analysis.spec.name
    values:
    - "\u30A2\u30EB\u30B4\u30EA\u30BA\u30E0\u4ED5\u69D8"
    - 
  - id: doc/analysis.spec.title
    values:
    - "\u88DC\u5B8C\u30A2\u30EB\u30B4\u30EA\u30BA\u30E0\u4ED5\u69D8\uFF08\u4F50\u4F2F\uFF09"
    - 
  - id: doc/analysis.spec.body
    values:
    - "\u300A\u88DC\u5B8C\u30A2\u30EB\u30B4\u30EA\u30BA\u30E0 \u6982\u7565\u300B\u3000\u62C5\u5F53:
      \u4F50\u4F2F\n\n\u8A18\u61B6\u306F\u300C\u50BE\u5411\u300D\u3067\u5206\u985E\u3055\u308C\u308B\u3002\n\u3000\u25CB
      \u611F\u60C5\u3000\u25B3 \u8A00\u8A9E\u3000\u25A1 \u884C\u52D5\n\n\u6B20\u640D\u3057\u305F\u8A18\u61B6\u306F\u3001\u6B8B\u3055\u308C\u305F\u8A18\u61B6\u306E\u50BE\u5411\u304B\u3089\n\u300C\u305D\u306E\u4EBA\u3089\u3057\u3044\u8A18\u61B6\u300D\u3092\u63A8\u5B9A\u3057\u3066\u57CB\u3081\u308B\u3002\n\u3000\u2192
      \u898F\u5247: \u6B20\u640D\u533A\u753B\u306B\u306F\u3001\u7D4C\u8DEF\u4E0A\u306E\u4E21\u96A3\u3068\n\u3000\u3000
      \u540C\u3058\u50BE\u5411\u3092\u7F6E\u304F\u3002\u7570\u306A\u308B\u50BE\u5411\u3092\u7F6E\u304F\u3068\n\u3000\u3000
      \u5149\u304C\u6FC1\u308A\u3001\u88DC\u5B8C\u306F\u5931\u6557\u3059\u308B\u3002\n\n\u6B04\u5916\u306E\u66F8\u304D\u8FBC\u307F:\n\u300C\u88DC\u5B8C\u3055\u308C\u305F\u8A18\u61B6\u306F\u3001\u672C\u5F53\u306B\u672C\u4EBA\u306E\u3082\u306E\u304B\uFF1F\u300D\n\u300C\u672C\u4EBA\u3092\u672C\u4EBA\u305F\u3089\u3057\u3081\u308B\u3082\u306E\u306F\u3001\u4F55\u3060\u300D"
    - 
  - id: doc/analysis.anomaly.name
    values:
    - "\u7570\u5E38\u30EC\u30DD\u30FC\u30C8"
    - 
  - id: doc/analysis.anomaly.title
    values:
    - "\u7570\u5E38\u30EC\u30DD\u30FC\u30C8\uFF08\u4F50\u4F2F\u2192\u6240\u9577\uFF09"
    - 
  - id: doc/analysis.anomaly.body
    values:
    - "\u300A\u7570\u5E38\u5831\u544A\u300B\u3000\u5831\u544A\u8005: \u4F50\u4F2F\n\n\u30FB\u5B58\u5728\u3057\u306A\u3044\u306F\u305A\u306E\u8A18\u61B6\u304C\u751F\u6210\u3055\u308C\u3066\u3044\u308B\n\u30FB\u30B7\u30B9\u30C6\u30E0\u304C\u7814\u7A76\u54E1\u81EA\u8EAB\u306E\u8133\u60C5\u5831\u3067\n\u3000\u5B66\u7FD2\u3057\u3066\u3044\u308B\u53EF\u80FD\u6027\u304C\u3042\u308B\n\u30FB\u81F3\u6025\u3001\u904B\u7528\u306E\u505C\u6B62\u3092\u9032\u8A00\u3059\u308B\n\n\u6240\u9577\u304B\u3089\u306E\u8FD4\u4FE1\u306F\u3001\u4E00\u884C\u3060\u3051\u3002\n\u300C\u4ECA\u306F\u7D50\u8AD6\u3092\u51FA\u3059\u306A\u300D\n\n\u2026\u2026\u79C1\u306F\u3001\u3053\u3053\u3067\u50CD\u3044\u3066\u3044\u305F\u3002\u601D\u3044\u51FA\u3057\u3066\u304D\u305F\u3002"
    - 
  - id: doc/analysis.toy.name
    values:
    - "\u304A\u3082\u3061\u3083\u306E\u8074\u8A3A\u5668"
    - 
  - id: doc/analysis.toy.title
    values:
    - "\u601D\u3044\u51FA\u306E\u65AD\u7247\uFF1A\u304A\u3082\u3061\u3083\u306E\u8074\u8A3A\u5668"
    - 
  - id: doc/analysis.toy.body
    values:
    - "\u304A\u533B\u8005\u3055\u3093\u3054\u3063\u3053\u3002\n\u300C\u304A\u7236\u3055\u3093\u306E\u5FC3\u81D3\u3001\u5143\u6C17\uFF1F\u300D\n\u300C\u5143\u6C17\u3060\u3088\u300D\u3068\u8A00\u3063\u305F\u9854\u304C\u3001\u5C11\u3057\u3060\u3051\u56F0\u3063\u3066\u3044\u305F\u3002"
    - 
  - id: doc/analysis.toy.hint
    values:
    - "\u5A18\u306E\u8A18\u61B6"
    - 
  - id: lock/analysis.circuit.name
    values:
    - "\u8A18\u61B6\u56DE\u8DEF\u7AEF\u672B"
    - 
  - id: lock/analysis.circuit.success_title
    values:
    - "\u8A18\u61B6\u56DE\u8DEF\uFF1A\u88DC\u5B8C\u30C6\u30B9\u30C8\u6210\u529F"
    - 
  - id: lock/analysis.circuit.success_body
    values:
    - "\u6B20\u640D\u533A\u753B\u306B\u4E21\u96A3\u3068\u540C\u3058\u50BE\u5411\u3092\u7F6E\u304F\u3068\u3001\u5149\u306F\u901A\u3063\u305F\u3002\n\u2500\u2500\u4ED5\u69D8\u3069\u304A\u308A\u3060\u3002\u79C1\u306F\u3053\u306E\u624B\u9806\u3092\u3001\u4F55\u5EA6\u3082\u3084\u3063\u305F\u6C17\u304C\u3059\u308B\u3002\n\n\u901A\u3057\u305F\u8A18\u61B6\u306F\u3001\u7570\u5E38\u30EC\u30DD\u30FC\u30C8\u306E\u8A00\u3046\n\u300C\u5B58\u5728\u3057\u306A\u3044\u306F\u305A\u306E\u8A18\u61B6\u300D\u3068\u3057\u3066\u767B\u9332\u3055\u308C\u305F\u3002"
    - 
  - id: lock/analysis.circuit.require
    values:
    - "\u307E\u3060\u3001\u5FC5\u8981\u306A\u3082\u306E\u304C\u63C3\u3063\u3066\u3044\u306A\u3044\u3002"
    - 
  - id: lock/analysis.circuit.title
    values:
    - "\u8A18\u61B6\u56DE\u8DEF\u3000\u2500\u2500 \u88DC\u5B8C\u30C6\u30B9\u30C8
      \u2500\u2500"
    - 
  - id: lock/analysis.circuit.body
    values:
    - "\u63D0\u4F9B\u4F53\u306E\u8A18\u61B6\uFF08\u5DE6\uFF09\u3092\u5BFE\u8C61\u8005\uFF08\u53F3\uFF09\u3078\u901A\u3059\u3002\u56DE\u8EE2\u3067\u7D4C\u8DEF\u3092\u4F5C\u308A\u3001\u6B20\u640D\u533A\u753B\uFF08?\uFF09\u306B\u306F\u50BE\u5411\u3092\u88DC\u5B8C\u3059\u308B\u3053\u3068\u3002"
    - 
  - id: room/saeki_home.name
    values:
    - "\u4F50\u4F2F\u306E\u81EA\u5B85"
    - 
  - id: room/saeki_home.chapter
    values:
    - "1\u7AE0\u300E\u4F50\u4F2F\u6052\u4E00\u300F\u3000\u2500 \u7D50 \u2500"
    - 
  - id: doc/saeki_home.letter.name
    values:
    - "\u66F8\u304D\u304B\u3051\u306E\u624B\u7D19"
    - 
  - id: doc/saeki_home.letter.title
    values:
    - "\u59BB\u306E\u66F8\u304D\u304B\u3051\u306E\u624B\u7D19"
    - 
  - id: doc/saeki_home.letter.body
    values:
    - "\u300A\u4FBF\u7B8B\u300B\n\n\u300C\u304A\u6BCD\u3055\u3093\u3078\u3002\u6052\u4E00\u3055\u3093\u306E\u3053\u3068\u3067\u76F8\u8AC7\u304C\u3042\u308A\u307E\u3059\u3002\n\u3000\u6700\u8FD1\u3001\u5E30\u308A\u304C\u3068\u3066\u3082\u9045\u3044\u3093\u3067\u3059\u3002\n\u3000\u4F55\u3092\u805E\u3044\u3066\u3082\u300E\u5927\u4E08\u592B\u3060\u300F\u3068\u3057\u304B\u2500\u2500\n\u3000\u6628\u65E5\u306F\u591C\u4E2D\u306B\u3001\u66F8\u658E\u3067\u4E00\u4EBA\u3067\n\u3000\u8AB0\u304B\u306B\u8B1D\u3063\u3066\u3044\u308B\u306E\u304C\u805E\u3053\u3048\u307E\u3057\u305F\u300D\n\n\u624B\u7D19\u306F\u3001\u305D\u3053\u3067\u7D42\u308F\u3063\u3066\u3044\u308B\u3002\n\u6295\u51FD\u3055\u308C\u308B\u3053\u3068\u306F\u3001\u306A\u304B\u3063\u305F\u3093\u3060\u308D\u3046\u3002"
    - 
  - id: doc/saeki_home.plog.name
    values:
    - "\u79C1\u7684\u30ED\u30B0"
    - 
  - id: doc/saeki_home.plog.title
    values:
    - "\u4F50\u4F2F\u306E\u79C1\u7684\u30ED\u30B0\uFF08\u6700\u7D42\u9801\uFF09"
    - 
  - id: doc/saeki_home.plog.body
    values:
    - "\u300A\u79C1\u7684\u8A18\u9332 \u6700\u7D42\u9801\u300B\n\n\u300C\u6240\u9577\u306F\u52D5\u304B\u306A\u3044\u3002\u9ED2\u7530\u3055\u3093\u306F\u6B63\u8AD6\u3057\u304B\u8A00\u308F\u306A\u3044\u3002\n\u3000\u306A\u3089\u3001\u79C1\u304C\u76F4\u63A5\u3042\u306E\u4EBA\u3068\u8A71\u3059\u3057\u304B\u306A\u3044\u3002\n\u3000\u60AA\u3044\u4EBA\u3067\u306F\u306A\u3044\u3093\u3060\u3002\u305F\u3060\u3001\u8FFD\u3044\u8A70\u3081\u3089\u308C\u3066\u3044\u308B\u3002\n\u3000\u4ECA\u591C\u3001\u89E3\u6790\u5BA4\u3067\u4F1A\u3046\u7D04\u675F\u3092\u3057\u305F\u300D\n\n\u6700\u5F8C\u306E\u884C\u306F\u3001\u7B46\u5727\u304C\u4E71\u308C\u3066\u3044\u308B\u3002\n\n\u300C\u2026\u2026\u4F55\u3092\u3059\u308B\u3064\u3082\u308A\u3067\u3059\u304B\uFF1F\u300D\n\n\u8A18\u9332\u306F\u3001\u305D\u3053\u3067\u9014\u5207\u308C\u3066\u3044\u305F\u3002"
    - 
  - id: doc/saeki_home.unsent.name
    values:
    - "\u672A\u9001\u4FE1\u30E1\u30E2"
    - 
  - id: doc/saeki_home.unsent.title
    values:
    - "\u5B9B\u5148\u306E\u306A\u3044\u30E1\u30E2"
    - 
  - id: doc/saeki_home.unsent.body
    values:
    - "\u300A\u8D70\u308A\u66F8\u304D\u300B\n\n\u300C\u3042\u306A\u305F\u306B\u4F1D\u3048\u305F\u3044\u3053\u3068\u304C\u3042\u308B\u3002\n\u3000\u3053\u3053\u304B\u3089\u5148\u3078\u884C\u3051\u3070\u3001\u3082\u3046\u623B\u308C\u306A\u304F\u306A\u308B\u3002\n\u3000\u5A18\u3055\u3093\u306E\u3053\u3068\u306F\u3001\u5225\u306E\u9053\u3092\u4E00\u7DD2\u306B\u63A2\u305B\u308B\u306F\u305A\u3060\u300D\n\n\u5B9B\u540D\u306F\u66F8\u304B\u308C\u3066\u3044\u306A\u3044\u3002\n\u2500\u2500\u3044\u3084\u3002\u66F8\u3051\u306A\u304B\u3063\u305F\u306E\u304B\u3002\n\u3053\u306E\u300C\u3042\u306A\u305F\u300D\u3068\u306F\u3001\u8AB0\u306E\u3053\u3068\u3060\u3002"
