    values:
    - "\u601D\u3044\u51FA\u306E\u65AD\u7247\uFF1A\u304A\u3082\u3061\u3083\u306E\u30AB\u30E1\u30E9"
    - 
  - id: doc/system_room.toy.body
    values:
    - "\u30AB\u30B7\u30E3\u3001\u3068\u97F3\u3060\u3051\u9CF4\u308B\u30AB\u30E1\u30E9\u3002\n\u304A\u7236\u3055\u3093\u3092\u3001\u4F55\u5EA6\u3082\u64AE\u3063\u305F\u3002\n\u5199\u771F\u306F\u3001\u4E00\u679A\u3082\u6B8B\u3089\u306A\u3044\u3002\u305C\u3093\u3076\u3001\u79C1\u306E\u4E2D\u306B\u3042\u308B\u3002"
